[build]
  command = "npm ci && npm run build"
  publish = "dist"
  functions = "netlify/functions"

[build.environment]
  NODE_VERSION = "20"
  NPM_FLAGS = "--legacy-peer-deps"

[dev]
  # Vite binds 127.0.0.1:5173; Netlify proxies that through :8888
  targetPort = 5173
  port = 8888

# Proxy /api requests to Netlify Functions to bypass aggressive adblockers/firewalls
[[redirects]]
  from = "/api/*"
  to = "/.netlify/functions/:splat"
  status = 200

# Microsoft 365 domain verification for fbs.com.sa (must stay at site root)
[[headers]]
  for = "/ms21837910.txt"
  [headers.values]
    Content-Type = "text/plain; charset=utf-8"

# SPA fallback is in public/_redirects (copied into dist). Do not put
# `/* → /index.html` here — it hangs Netlify Dev on :8888.

[[edge_functions]]
  path = "/*"
  function = "payment-blocker"
